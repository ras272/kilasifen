# Core runtime
KILA_SIFEN_API_TITLE=Kila SIFEN
KILA_SIFEN_API_VERSION=v1
KILA_SIFEN_LOG_LEVEL=INFO
KILA_SIFEN_SIFEN_ENVIRONMENT=test

# Security
# Replace with a generated Fernet key:
# python - <<'PY'
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())
# PY
KILA_SIFEN_ENCRYPTION_KEY=replace-with-fernet-key
KILA_SIFEN_API_KEYS=["local-dev-api-key"]

# Infrastructure
POSTGRES_DB=kilasifen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
KILA_SIFEN_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/kilasifen
KILA_SIFEN_REDIS_URL=redis://redis:6379/0

