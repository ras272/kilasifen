# Runtime mode. Keep local Compose in development; Railway staging uses staging.
KILA_SIFEN_ENVIRONMENT=development
KILA_SIFEN_API_TITLE=Kila SIFEN
KILA_SIFEN_API_VERSION=v1
KILA_SIFEN_LOG_LEVEL=INFO

# Required secrets: intentionally blank/empty in this example.
KILA_SIFEN_API_KEYS=[]
KILA_SIFEN_ENCRYPTION_KEY=

# Local Compose infrastructure. Replace POSTGRES_PASSWORD before starting.
POSTGRES_DB=kilasifen
POSTGRES_USER=kilasifen
POSTGRES_PASSWORD=
KILA_SIFEN_DATABASE_URL=
KILA_SIFEN_TEST_DATABASE_URL=
KILA_SIFEN_REDIS_URL=redis://redis:6379/0

# Fiscal boundary. Staging accepts test only.
KILA_SIFEN_SIFEN_ENVIRONMENT=test
KILA_SIFEN_ENABLE_PRODUCTION=false

# Emission switches: keep both true. The code defaults them to false and no
# validation requires them, so leaving them out silently stops the pipeline.
# Give every process the same values (Compose shares this file with api,
# worker and outbox; on Railway see docs/DEPLOYMENT.md).
# - AUTO_ENQUEUE is read by the API. When false, a new document and its job
#   are stored as queued but never handed to the outbox, so nothing is emitted.
# - PUBLISH_WEBHOOKS is read by the worker. When false, document status
#   changes publish no webhooks.
KILA_SIFEN_DOCUMENT_AUTO_ENQUEUE=true
KILA_SIFEN_DOCUMENT_PUBLISH_WEBHOOKS=true

# dNomEmi for emitters of the SIFEN test environment (validation 1263). Empty
# keeps the legal name. Which literal SIFEN test accepts is not determined:
# the Manual Tecnico v150 asks for
#   DE generado en ambiente de prueba - sin valor comercial ni fiscal
# and the DNIT test guide (feb-2026) for
#   DOCUMENTO ELECTRÓNICO SIN VALOR COMERCIAL NI FISCAL - GENERADO EN AMBIENTE DE PRUEBA
# It never applies to production emitters (see docs/normativa/matriz.md).
KILA_SIFEN_TEST_EMITTER_NAME_LITERAL=

# Abuse/resource controls.
KILA_SIFEN_MAX_PFX_UPLOAD_BYTES=2097152
KILA_SIFEN_MAX_JSON_REQUEST_BODY_BYTES=1048576
KILA_SIFEN_MULTIPART_BODY_OVERHEAD_BYTES=65536
KILA_SIFEN_REQUEST_LIMITS_ENABLED=true
KILA_SIFEN_PRE_AUTH_RATE_LIMIT_REQUESTS=600
KILA_SIFEN_PRE_AUTH_MAX_CONCURRENT_REQUESTS=32
# Only list reverse-proxy networks you operate; otherwise forwarded IPs are ignored.
KILA_SIFEN_TRUSTED_PROXY_CIDRS=[]
KILA_SIFEN_RATE_LIMIT_REQUESTS=120
KILA_SIFEN_RATE_LIMIT_WINDOW_SECONDS=60
KILA_SIFEN_MAX_CONCURRENT_REQUESTS=8
KILA_SIFEN_REQUEST_LEASE_SECONDS=120
KILA_SIFEN_READINESS_CACHE_SECONDS=5

# Optional observability. Leave DSN blank to disable Sentry.
KILA_SIFEN_SENTRY_DSN=
KILA_SIFEN_SENTRY_ENVIRONMENT=development
KILA_SIFEN_SENTRY_RELEASE=
KILA_SIFEN_SENTRY_TRACES_SAMPLE_RATE=0
